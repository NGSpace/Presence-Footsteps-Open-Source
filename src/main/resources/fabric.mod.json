{
  "schemaVersion": 1,
  "id": "presencefootsteps",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "Hurricaaane (Ha3)", "Sollace", "NGSpace"
  ],
  "contact": {
    "sources": "https://github.com/NGSpace/Presence-Footsteps-Open-Source",
    "issues": "https://github.com/NGSpace/Presence-Footsteps-Open-Source/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "eu.ha3.presencefootsteps.PresenceFootsteps"
    ],
    "modmenu": [
      "eu.ha3.presencefootsteps.PFModMenuFactory"
    ]
  },
  "mixins": [
    "presencefootsteps.mixin.json"
  ],
  "depends": {
    "minecraft": "${minecraftVersion}",
    "fabricloader": "${loaderVersion}",
    "java": ">=21",
    "fabric-api": "${fabricVersion}",
    "yet_another_config_lib_v3": "${yaclVersion}"
  },
  "suggests": {
    "modmenu": "${modmenuVersion}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://ngspace.dev/discord",
        "modmenu.modrinth": "https://modrinth.com/mod/presence-footsteps-open-source"
      },
      "update_checker": true
    }
  }
}
